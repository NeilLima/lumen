generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         Profile?
  accounts        Account[]
  products        Product[]
  compras         Compra[]
  categories      Category[]
  transactions    Transaction[]
  creditCards     CreditCard[]
  goals           Goal[]
  debts           Debt[]
  investments     Investment[]
  subscriptions   Subscription[]
  budgets         Budget[]
  notifications   Notification[]
  metas           Meta[]
  settings        Setting[]

  @@map("users")
}

model Profile {
  id         String    @id @default(uuid())
  userId     String    @unique
  firstName  String
  lastName   String
  countryIso2 String?
  stateIso2  String?
  city       String?
  birthDate  DateTime?
  gender     String?
  avatar     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  bank      String?  // nome do banco (ex.: Nubank)
  type      String   @default("CHECKING") // CHECKING | SAVINGS | WALLET | INVESTMENT
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("AccountTransactions")

  @@map("accounts")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  icon      String?
  type      String   @default("BOTH") // INCOME | EXPENSE | BOTH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("CategoryTransactions")
  subscriptions Subscription[] @relation("CategorySubscriptions")
  budgets Budget[] @relation("CategoryBudgets")
  debts Debt[] @relation("CategoryDebts")

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  description   String
  amount        Decimal  @db.Decimal(14, 2)
  type          String // INCOME | EXPENSE | TRANSFER
  status        String   @default("PENDING") // RECEIVED | PENDING | LATE
  date          DateTime @default(now())
  paymentMethod String?
  recurrence    String? // NONE | WEEKLY | MONTHLY | YEARLY
  notes         String?
  attachment    String? // URL real do comprovante (blob:/data: sao recusados)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  accountId     String?
  creditCard    CreditCard? @relation("CreditCardTransactions", fields: [creditCardId], references: [id], onDelete: SetNull)
  creditCardId  String?
  category      Category? @relation("CategoryTransactions", fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}
model CreditCard {
  id        String   @id @default(uuid())
  userId    String
  name      String
  bank      String?
  brand     String   @default("VISA") // VISA | MASTERCARD | ELO | AMEX | HIPERCARD | DINERS | DISCOVER | OUTRO
  limitTotal   Decimal @db.Decimal(14, 2)
  limitUsed    Decimal @default(0) @db.Decimal(14, 2)
  dueDay       Int     @default(10) // vencimento da fatura
  closingDay   Int?    // melhor dia de compra / fechamento
  color        String?
  status       String   @default("ACTIVE") // ACTIVE | BLOCKED | CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[] @relation("CreditCardTransactions")

  @@index([userId])
  @@map("credit_cards")
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  name        String
  targetAmount Decimal @db.Decimal(14, 2)
  currentAmount Decimal @default(0) @db.Decimal(14, 2)
  deadline    DateTime?
  color       String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model Debt {
  id             String   @id @default(uuid())
  userId         String
  name           String
  type           String   @default("DEBT") // DEBT | LOAN
  totalAmount    Decimal  @db.Decimal(14, 2)
  remainingAmount Decimal @db.Decimal(14, 2)
  interestRate   Decimal?
  dueDate        DateTime?
  parcels        Int      @default(0)
  parcelasPagas  Int      @default(0)
  status         String   @default("em_dia") // em_dia | atrasada | quitada
  categoryId     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation("CategoryDebts", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@map("debts")
}

model Investment {
  id             String   @id @default(uuid())
  userId         String
  name           String
  type           String   @default("OTHER") // STOCKS | FUNDS | CRYPTO | TESOURO | CDB | OTHER
  broker         String?
  currentValue   Decimal  @db.Decimal(14, 2)
  investedAmount Decimal  @default(0) @db.Decimal(14, 2)
  appliedDate    DateTime?
  status         String   @default("ativo")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("investments")
}

model Subscription {
  id          String   @id @default(uuid())
  userId      String
  name        String
  amount      Decimal @db.Decimal(14, 2)
  dueDay      Int      @default(10) // dia do mes da cobranca
  categoryId  String?
  nextCharge  DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation("CategorySubscriptions", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("subscriptions")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String?
  month       String // YYYY-MM
  limitAmount Decimal @db.Decimal(14, 2)
  spentAmount Decimal @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category? @relation("CategoryBudgets", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@map("budgets")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String // PAYMENT_DUE | BILL_EXPIRING | GOAL_REACHED | CARD_LIMIT | BUDGET_EXCEEDED
  title       String
  message     String?
  read        Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model Product {
  id           String   @id @default(uuid())
  userId       String
  name         String
  category     String
  unit         String   @default("un")
  local        String?  // local de compra
  price        Decimal? @db.Decimal(14, 2) // preco
  installments Int      @default(1) // parcelas
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockItems  EstoqueItem[]
  compraItens CompraItem[]

  @@index([userId])
  @@map("products")
}

model EstoqueItem {
  id            String   @id @default(uuid())
  userId        String
  productId     String?
  nome          String
  categoria     String
  quantidade    Decimal  @db.Decimal(14, 2)
  unidade       String
  preco         Decimal  @db.Decimal(14, 2)
  localCompra   String
  quantidadeMinima Decimal @db.Decimal(14, 2)
  dataAtualizacao DateTime @updatedAt
  createdAt     DateTime @default(now())

  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("estoque_itens")
}

model Setting {
  id          String   @id @default(uuid())
  userId      String
  name        String
  category    String   @default("geral")
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("settings")
}

model Meta {
  id             String   @id @default(uuid())
  userId         String
  nome           String
  valorAlvo      Decimal  @db.Decimal(14, 2)
  valorAtual     Decimal  @default(0) @db.Decimal(14, 2)
  dataLimite     String
  categoria      String
  categoriaCor   String?
  categoriaIcone String?
  prioridade     String   @default("media")
  status         String   @default("em_andamento")
  descricao      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("metas")
}

model Compra {
  id                String        @id @default(uuid())
  userId            String
  local             String?
  dataCompra        DateTime      @default(now())
  statusPagamento   String        @default("pendente") // pago | pendente | parcelado
  parcels           Int           @default(1)
  parcelasPagas     Int           @default(0)
  totalAmount       Decimal       @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itens CompraItem[]

  @@index([userId])
  @@map("compras")
}

model CompraItem {
  id             String   @id @default(uuid())
  compraId       String
  productId      String?
  nome           String
  quantidade     Decimal  @db.Decimal(14, 2)
  unidade        String   @default("un")
  precoUnitario  Decimal  @db.Decimal(14, 2)
  subtotal       Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  compra  Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([compraId])
  @@map("compra_itens")
}

